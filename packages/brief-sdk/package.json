{
  "name": "brief-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the Brief protocol — explicit agent delegation made simple.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
